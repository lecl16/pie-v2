# Reference only — do not copy this file to `.env` by hand.
#
# Run `./scripts/setup.sh` instead: it creates a real `.env` next to this
# file with unique, randomly-generated secrets for your deployment.
# This file just documents every variable the API reads.

# FastAPI
APP_PORT=8000
JWT_SECRET_KEY=changeme-generated-by-setup-script
JWT_ALGORITHM=HS256
# Wraps the exam devices' TLS pre-shared keys (README.md, "Device TLS-PSK"); 32 bytes hex
DEVICE_PSK_WRAP_KEY=changeme-generated-by-setup-script
# The API's address as teachers' browsers reach it, compiled into the
# dashboard (the webapp service). Rebuild after changing it.
PIE_API_URL=https://192.168.1.50:8000

# MySQL Database
MYSQL_ROOT_PASSWORD=changeme-generated-by-setup-script
MYSQL_USER=pie
MYSQL_PASSWORD=changeme-generated-by-setup-script
MYSQL_DB=pie_api_db
MYSQL_HOST=db
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://pie:changeme-generated-by-setup-script@db:3306/pie_api_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ElasticSearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# Log Settings
LOG_RETENTION_DAYS=7
LOG_MAX_STREAM_LENGTH=1000
