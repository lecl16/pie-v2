[Unit]
Description=PIE NFC provisioning reader
After=nfc-venv-init.service
Requires=nfc-venv-init.service
# Keep restarting however often it fails (e.g. the PN532 missing after a
# power glitch), so the reader comes back by itself once the chip answers.
StartLimitIntervalSec=0

[Service]
Type=simple
# Runs as root: needs raw /dev/i2c-1 access for the PN532, and this is a
# narrowly-scoped local hardware helper, not a network-facing service.
# print() output is block-buffered when stdout is not a TTY, so without
# this nothing reaches journalctl until the buffer fills.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nfc-reader/venv/bin/python /opt/nfc-reader/reader_script.py
WorkingDirectory=/opt/nfc-reader
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
