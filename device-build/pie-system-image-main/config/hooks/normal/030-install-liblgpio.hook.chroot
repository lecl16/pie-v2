#!/bin/bash
set -e

# adafruit-blinka's "lgpio" GPIO backend (used by adafruit-circuitpython-pn532
# for the NFC reader, see NFC-Support/reader_script.py) is a Python wrapper
# around a separate native liblgpio.so. pip cannot build that wrapper without
# the C library already installed, and unlike Raspberry Pi OS this Debian
# base has no apt package for it. Build it from source once here, at image
# build time, so first boot doesn't need to compile anything.
BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "$BUILD_DIR"' EXIT

cd "$BUILD_DIR"
wget -q https://github.com/joan2937/lg/archive/refs/heads/master.tar.gz -O lg.tar.gz
tar xf lg.tar.gz
cd lg-master
make
make install
ldconfig
