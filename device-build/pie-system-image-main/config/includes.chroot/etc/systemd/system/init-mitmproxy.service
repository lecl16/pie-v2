[Unit]
Description=Create the mitmproxy CA and publish it for Firefox
# Before the login screen, so Firefox finds the certificate on first start.
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/init-mitmproxy.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
